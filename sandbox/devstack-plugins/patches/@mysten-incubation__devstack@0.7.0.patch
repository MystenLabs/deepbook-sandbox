+// --- SANDBOX PATCH (deepbook-sandbox, SEDEFI-444): known-mode Pyth feeds ----
+// Upstream 0.7.0 hardcodes `feeds: []` in KNOWN_DEEPBOOK_DEPLOYMENTS, so the
+// dashboard's DeepBook page renders no oracle data for known deployments.
+// Until devstack implements this natively ("option B": read feeds at boot),
+// resolve the per-network feed list from @mysten/deepbook-v3's coin tables and
+// read each PriceInfoObject on-chain for real price/expo. Reads are lenient —
+// an unreadable feed is skipped with a warning, never a boot failure. On a
+// mainnet fork the read also lazy-materializes the shared PriceInfoObject,
+// which is exactly what later Pyth consumers need.
+const KNOWN_PYTH_FEED_SYMBOLS = ["DEEP", "SUI", "USDC"];
+const pythI64 = bcs.struct("PythI64", {
+	negative: bcs.bool(),
+	magnitude: bcs.u64()
+});
+const pythPrice = bcs.struct("PythPrice", {
+	price: pythI64,
+	conf: bcs.u64(),
+	expo: pythI64,
+	timestamp: bcs.u64()
+});
+const pythPriceInfoObject = bcs.struct("PythPriceInfoObject", {
+	id: bcs.Address,
+	price_info: bcs.struct("PythPriceInfo", {
+		attestation_time: bcs.u64(),
+		arrival_time: bcs.u64(),
+		price_feed: bcs.struct("PythPriceFeed", {
+			price_identifier: bcs.struct("PythPriceIdentifier", { bytes: bcs.vector(bcs.u8()) }),
+			price: pythPrice,
+			ema_price: pythPrice
+		})
+	})
+});
+const i64Signed = (v) => (v.negative ? -1n : 1n) * BigInt(v.magnitude);
+const knownPythFeedCoins = (network) => {
+	const table = network === "mainnet" ? mainnetCoins : network === "testnet" ? testnetCoins : null;
+	if (!table) return [];
+	return KNOWN_PYTH_FEED_SYMBOLS.flatMap((symbol) => {
+		const coin = table[symbol];
+		return coin?.feed && coin?.priceInfoObjectId ? [{
+			symbol,
+			feedId: coin.feed,
+			priceInfoObjectId: coin.priceInfoObjectId
+		}] : [];
+	});
+};
+const readKnownPythFeeds = (sdk, network) => Effect.gen(function* () {
+	const coins = knownPythFeedCoins(network);
+	if (coins.length === 0) return [];
+	const feeds = [];
+	for (const coin of coins) {
+		// Per-object reads: the fork serves LedgerService/GetObject but not
+		// BatchGetObjects, and the sui member's core facade only exposes the
+		// singular call anyway.
+		const obj = yield* Effect.tryPromise({
+			try: () => sdk.core.getObject({
+				objectId: coin.priceInfoObjectId,
+				include: { content: true }
+			}).then((res) => res.object ?? null),
+			catch: (cause) => cause
+		}).pipe(Effect.catch((cause) => Effect.logWarning(`deepbook known mode: Pyth PriceInfoObject ${coin.priceInfoObjectId} (${coin.symbol}) read failed (${String(cause)}); skipping feed`).pipe(Effect.as(null))));
+		if (obj === null || obj.content === void 0 || obj.content === null) {
+			yield* Effect.logWarning(`deepbook known mode: Pyth PriceInfoObject ${coin.priceInfoObjectId} (${coin.symbol}) unreadable; skipping feed`);
+			continue;
+		}
+		let parsed;
+		try {
+			parsed = pythPriceInfoObject.parse(obj.content);
+		} catch (cause) {
+			yield* Effect.logWarning(`deepbook known mode: Pyth PriceInfoObject ${coin.priceInfoObjectId} (${coin.symbol}) failed to parse (${String(cause)}); skipping feed`);
+			continue;
+		}
+		const price = parsed.price_info.price_feed.price;
+		feeds.push({
+			symbol: coin.symbol,
+			feedId: coin.feedId,
+			priceInfoObjectId: coin.priceInfoObjectId,
+			price: i64Signed(price.price),
+			expo: Number(i64Signed(price.expo))
+		});
+	}
+	return feeds;
+});
