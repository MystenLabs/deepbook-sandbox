 const EM_DASH = '—';
 
+// ---- DeepBook server (indexer query surface) --------------------------------
+
+type TickerEntry = {
+	readonly last_price: number;
+	readonly base_volume: number;
+	readonly quote_volume: number;
+	readonly isFrozen: number;
+};
+/** `/ohclv/:pool` candles: `[timestamp_ms, open, high, low, close, volume]`. */
