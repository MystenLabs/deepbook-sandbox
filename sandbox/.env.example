# DeepBook Sandbox Environment Variables
#
# NOTE (DBSF-032): the docker-compose stack was the thing that auto-loaded
# `.env`, and it is gone — the whole stack is devstack now, which reads the
# SHELL environment of `pnpm deploy-all` / `pnpm stack:up`. Export overrides
# (FORK_CHECKPOINT, INDEXER_IMAGE, SERVER_IMAGE, POSTGRES_IMAGE, RUST_LOG,
# DEEP_DONOR_ADDRESS, MM_*, …) in your shell instead of editing `.env`.
# This file remains as the variable catalog.

# Private key for the deployer/signer (suiprivkey1... or 0x... hex).
# Required for deployment and pool creation.
# Export your active address key with:
#   sui keytool export --key-identity $(sui client active-address)
PRIVATE_KEY=

# Oracle service keypair (auto-generated by deploy-all for localnet).
# The oracle service uses a separate keypair so it doesn't compete for gas
# coins with the market maker / deployer.
# ORACLE_PRIVATE_KEY=

# =============================================================================
# Sui Localnet
# =============================================================================
# Set based on your CPU architecture:
#   ARM64 (Apple Silicon M1/M2/M3/M4): mysten/sui-tools:testnet-v1.75.1-arm64
#   x86_64 (Intel/AMD):                mysten/sui-tools:testnet-v1.75.1
SUI_TOOLS_IMAGE=mysten/sui-tools:testnet-v1.75.1-arm64

# Wipe chain state on every restart (default: true)
# Set to empty to persist state across restarts
FORCE_REGENESIS=true

# =============================================================================
# Network Configuration
# =============================================================================
# Sui RPC endpoint URL (optional — defaults to http://127.0.0.1:9000 for localnet)
# Only set this to override the default.
# RPC_URL=http://127.0.0.1:9000

# =============================================================================
# Package IDs (auto-populated by deploy-all for localnet)
# =============================================================================
# For localnet: leave empty — deploy-all writes these automatically.

# DeepBook package
# DEEPBOOK_PACKAGE_ID=

# DEEP token package
# DEEP_TOKEN_PACKAGE_ID=

# DEEP treasury object ID
# DEEP_TREASURY_ID=

# Margin trading package (optional)
# MARGIN_PACKAGE_ID=

# =============================================================================
# Fork impersonation — DEEP funding
# =============================================================================
# Mainnet DEEP holder the sandbox impersonates on a sui-fork to fund DEEP.
# Default below holds ~46% of DEEP supply; rationale + risk profile + caps are in
# deployments/fork-impersonation.md. (USDC needs no donor — it's minted via the
# Circle master-minter; see scripts/spikes/usdc/.)
DEEP_DONOR_ADDRESS=0x9548232f9cebbc1eec56cfb25b99f61e17924b4908248c260c8d70100c59c70d

# Funding caps (guardrails; fork-only, no mainnet effect).
# MAX_DEEP_PER_REQUEST=100000
# MAX_DEEP_PER_SESSION=10000000
# USDC is minted (no donor), but capped for realism.
# MAX_USDC_PER_REQUEST=10000

# =============================================================================
# Fork impersonation — USDC funding (minted, not transferred)
# =============================================================================
# USDC is minted on the fork by impersonating Circle's master-minter and calling
# the stablecoin framework's treasury::mint — no donor / drain ceiling. These are
# the MAINNET ids the fork inherits (verified on mainnet 2026-06-19; rationale +
# the master-minter derivation are in deployments/fork-impersonation.md). In fork
# mode USDC_TOKEN_PACKAGE_ID is the mainnet USDC package below, not a localnet one.
# USDC_TOKEN_PACKAGE_ID=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7
# USDC_TREASURY_ID=0x57d6725e7a8b49a7b2a612f6bd66ab5f39fc95332ca48be421c3229d514a6de7
# USDC_MINTER_ADDRESS=0x41c0c6d67577b39f31a5fe4052314fd3a8b7c7f890676f60e007bd390e397ac1
# Supporting ids (stablecoin framework pkg + the TreasuryCap under the Treasury):
# USDC_STABLECOIN_PACKAGE_ID=0xecf47609d7da919ea98e7fd04f6e0648a0a79b337aaad373fa37aac8febf19c8
# USDC_TREASURY_CAP_ID=0x677e41a5c35d90177d401b72952c228ffa65b770e265561ad607f34d6896dcc2

# =============================================================================
# Market Maker (only needed if using docker market-maker service)
# =============================================================================
# Spread in basis points (default: 10 = 0.1%)
# MM_SPREAD_BPS=10

# Number of orders per side (default: 5)
# MM_LEVELS_PER_SIDE=5

# Order size in base asset units (default: 10_000_000 = 10 DEEP)
# MM_ORDER_SIZE_BASE=10000000

# Rebalance interval in milliseconds (default: 10000)
# MM_REBALANCE_INTERVAL_MS=10000

# Health check port inside container (default: 3000, mapped to host 3001)
# MM_HEALTH_CHECK_PORT=3000

# Prometheus metrics port inside container (default: 9090, mapped to host 9091)
# MM_METRICS_PORT=9090

# =============================================================================
# Docker Images (devstack container members — export in the shell)
# =============================================================================
# INDEXER_IMAGE: a prebuilt fork-indexer tag; skips the local repo-root build
#   (devstack-plugins/indexer-member.ts).
# SERVER_IMAGE: overrides the pinned mysten/deepbookv3-server tag; ARM64 tags
#   use the -arm64 suffix. SERVER_IMAGE_BUILD=1 builds from the submodule
#   instead (server-member.ts).
# POSTGRES_IMAGE: overrides postgres:16-alpine (postgres-member.ts).
# INDEXER_IMAGE=
# SERVER_IMAGE=
# POSTGRES_IMAGE=

# Stack-wrapper knobs (scripts/stack.ts):
# POSTGRES_HOST_PORT=5432          # postgres member's published host port
# DEEPBOOK_SERVER_URL=http://127.0.0.1:9008   # what the deepbook() member/dashboard read
# STACK_READY_TIMEOUT_MS=480000    # deploy-all fund-ready budget
# STACK_SETTLE_TIMEOUT_MS=5400000  # deploy-all member-settle budget (cold indexer build!)

# =============================================================================
# Indexer Configuration (Optional)
# =============================================================================
# The indexer's start checkpoint always equals the fork pin: set FORK_CHECKPOINT
# (see devstack-plugins/fork-checkpoint.ts for the grammar — <n> | latest);
# there is no separate FIRST_CHECKPOINT to keep in sync anymore (DBSF-032).
# FORK_CHECKPOINT=

# Log level: trace, debug, info, warn, error
# RUST_LOG=info

# =============================================================================
# Faucet Service (port 9009)
# =============================================================================
# Distributes SUI (proxied from Sui faucet) and DEEP tokens for testing.
# Uses the deployer's PRIVATE_KEY to sign DEEP transfers.
# DEEP_TOKEN_PACKAGE_ID is required to construct the DEEP coin type.
# RPC_URL is shared with the rest of the stack.

# =============================================================================
# Database (wired by the devstack members, no need to set)
# =============================================================================
# The indexer/server containers get their DSN from the postgres member
# (postgresql://postgres:postgres@postgres:5432/deepbook on the stack network;
# host psql: port 5432, or `docker exec` the container by devstack label).
