{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "rootDir": ".",
        "types": ["node"],
        // scripts are tsx-run (never emitted); .ts-suffixed imports let them
        // share modules with devstack-plugins/ (pools-seed-sql.ts).
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": ["scripts/**/*"],
    // Spikes are frozen exploration records with their own (absent) dep
    // trees — excluding them makes `pnpm exec tsc` a usable gate.
    "exclude": ["node_modules", "dist", "scripts/spikes"]
}
